[
    {
        "id": "restart",
        "execute-command": "/scripts/restart.sh",
        "pass-arguments-to-command": [
            {
                "source": "url",
                "name": "target"
            }
        ],
        "trigger-rule": {
            "or": [
                {
                    "match": {
                        "type": "value",
                        "value": "{{ getenv `ADMIN_TOKEN` }}",
                        "parameter": {
                            "source": "header",
                            "name": "X-Admin-Token"
                        }
                    }
                },
                {
                    "match": {
                        "type": "value",
                        "value": "{{ getenv `ADMIN_TOKEN` }}",
                        "parameter": {
                            "source": "url",
                            "name": "token"
                        }
                    }
                }
            ]
        }
    },
    {
        "id": "deploy",
        "execute-command": "/scripts/deploy.sh",
        "pass-arguments-to-command": [
            {
                "source": "url",
                "name": "service"
            }
        ],
        "trigger-rule": {
            "or": [
                {
                    "match": {
                        "type": "value",
                        "value": "{{ getenv `ADMIN_TOKEN` }}",
                        "parameter": {
                            "source": "header",
                            "name": "X-Admin-Token"
                        }
                    }
                },
                {
                    "match": {
                        "type": "value",
                        "value": "{{ getenv `ADMIN_TOKEN` }}",
                        "parameter": {
                            "source": "url",
                            "name": "token"
                        }
                    }
                }
            ]
        }
    }
]