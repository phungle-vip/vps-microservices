    listen 80;
    server_name ${WEBHOOK_SUBDOMAIN}.${DOMAIN};

    client_max_body_size 10m;

    location / {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $upstream_webhook http://${WEBHOOK_HOST}:${WEBHOOK_PORT};
        proxy_pass $upstream_webhook;

        proxy_http_version 1.1;
