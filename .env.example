# =================================================================
# ENVIRONMENT CONFIGURATION FOR VPS-MICROSERVICES (RideHub)
# Copy this file to .env: cp .env.example .env
# =================================================================

# Domain Configuration
DOMAIN=phungvip.io.vn

# Master Password (used for MySQL databases and services)
APP_F4_PASS=f4security
MYSQL_ROOT_PASSWORD=f4security

# Spring Configuration
SPRING_PROFILES_ACTIVE=prod,api-docs
JAVA_OPTIONS=-Xmx512m -Xms256m

# Cross-VPS Consul connection. For same-host Docker simulation, use:
# CONSUL_HOST=host.docker.internal
# CONSUL_PORT=8500
# CONSUL_SCHEME=http
CONSUL_HOST=consul.${DOMAIN}
CONSUL_PORT=443
CONSUL_SCHEME=https
CONSUL_DISCOVERY_SCHEME=https
GATEWAY_DISCOVERY_ADDRESS=apigateway.${DOMAIN}
MS_BOOKING_DISCOVERY_ADDRESS=msbooking.${DOMAIN}
MS_PROMOTION_DISCOVERY_ADDRESS=mspromotion.${DOMAIN}
MS_ROUTE_DISCOVERY_ADDRESS=msroute.${DOMAIN}
MS_USER_DISCOVERY_ADDRESS=msuser.${DOMAIN}

# Cloudflare Tunnel Configuration
# Tunnel is managed via ./cloudflared/config.yml and ./cloudflared/credentials.json
