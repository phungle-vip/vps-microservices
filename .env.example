# =================================================================
# ENVIRONMENT CONFIGURATION FOR VPS-MICROSERVICES (RideHub)
# Copy this file to .env: cp .env.example .env
# =================================================================

# Domain Configuration
DOMAIN=phungvip.io.vn
TZ=Asia/Ho_Chi_Minh

# Master Password (used for MySQL databases and services)
APP_F4_PASS=your_master_password
MYSQL_ROOT_PASSWORD=your_mysql_root_password
REDIS_PASSWORD=your_redis_password

# Security & Admin Tokens
VAULT_TOKEN=your_vault_token
ADMIN_TOKEN=your_webhook_admin_token

# Consul ACL Tokens (đọc trực tiếp theo service, không fallback)
CONSUL_TOKEN_APIGATEWAY=your_gateway_consul_token
CONSUL_TOKEN_MSBOOKING=your_msbooking_consul_token
CONSUL_TOKEN_MSUSER=your_msuser_consul_token
CONSUL_TOKEN_MSROUTE=your_msroute_consul_token
CONSUL_TOKEN_MSPROMOTION=your_mspromotion_consul_token

# Spring Configuration
SPRING_PROFILES_ACTIVE=prod,api-docs
JAVA_OPTIONS="-Xmx512m -Xms256m -Duser.timezone=Asia/Ho_Chi_Minh"

# Cross-VPS Consul connection. For same-host Docker simulation, use:
# CONSUL_HOST=host.docker.internal
# CONSUL_PORT=8500
# CONSUL_SCHEME=http
CONSUL_HOST=consul.${DOMAIN}
CONSUL_PORT=443
CONSUL_SCHEME=https
CONSUL_DISCOVERY_SCHEME=https
# Note: Service discovery hostnames & addresses (e.g. apigateway.${DOMAIN}, msuser.${DOMAIN})
# are dynamically resolved by generate-configs.sh based on detected backend services.

# Cloudflare Zero Trust & Tunnel (Cloudflare-First)
TUNNEL_TOKEN=
CF_API_TOKEN=your_cloudflare_api_token
CF_ACCOUNT_ID=your_cloudflare_account_id

# Observability (Centralized Monitoring in VPS-Infra)
# For same-host simulation: http://host.docker.internal:3100 and http://host.docker.internal:9090/api/v1/write
# For separate VPS with domain: https://loki.${DOMAIN} and https://prometheus.${DOMAIN}/api/v1/write
LOKI_URL=http://host.docker.internal:3100
PROMETHEUS_REMOTE_WRITE_URL=http://host.docker.internal:9090/api/v1/write

